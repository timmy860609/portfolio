---
import PasscodeGate from '../components/PasscodeGate.astro';
import { withBase } from '../utils/basePath';
import '@fontsource/montserrat/latin-600.css';

const homePath = withBase('/');
const faviconPath = withBase('/WebCI/ci-logo.svg');
---

<!doctype html>
<html lang="zh-Hant" class="portfolio-locked">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="robots" content="noindex, nofollow" />
    <link rel="icon" href={faviconPath} type="image/svg+xml" />
    <title>Timmy Lee｜Private Portfolio</title>
    <script is:inline define:vars={{ homePath }}>
      (() => {
        try {
          if (sessionStorage.getItem('portfolio-access-granted') !== 'true') {
            return;
          }

          const requestedReturnTo = new URLSearchParams(location.search).get(
            'returnTo',
          );
          const returnTo = requestedReturnTo?.startsWith(homePath)
            ? requestedReturnTo
            : homePath;
          location.replace(returnTo);
        } catch {
          // Keep the passcode screen available when storage is unavailable.
        }
      })();
    </script>
  </head>
  <body>
    <PasscodeGate redirectOnUnlock defaultReturnTo={homePath} />
  </body>
</html>

<style is:global>
  html,
  body {
    background: #131313;
    margin: 0;
    min-height: 100%;
  }

  * {
    box-sizing: border-box;
  }
</style>
