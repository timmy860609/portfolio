---
import BaseLayout from '../../layouts/BaseLayout.astro';
import HiringDetail from '../../components/project/HiringDetail.vue';
import IotGatewayDetail from '../../components/project/IotGatewayDetail.vue';
import LifePlatformDetail from '../../components/project/LifePlatformDetail.vue';
import MarketingCollectionDetail from '../../components/project/MarketingCollectionDetail.vue';
import MobileBankDetail from '../../components/project/MobileBankDetail.vue';
import SmartFitnessDetail from '../../components/project/SmartFitnessDetail.vue';
import ProjectScrollEffects from '../../components/project/ProjectScrollEffects.vue';
import StandardProjectDetail from '../../components/project/StandardProjectDetail.vue';
import {
  vipMemberPlatformContentSections,
  vipMemberPlatformCover,
  vipMemberPlatformGoals,
  vipMemberPlatformHero,
} from '../../data/project/vipMemberPlatformProject';
import {
  hrOfficialContentSections,
  hrOfficialCover,
  hrOfficialGoals,
  hrOfficialHero,
} from '../../data/project/hrOfficialProject';
import {
  openAccountContentSections,
  openAccountCover,
  openAccountGoals,
  openAccountHero,
} from '../../data/project/openAccountProject';
import {
  jobPlatformContentSections,
  jobPlatformCover,
  jobPlatformGoals,
  jobPlatformHero,
} from '../../data/project/jobPlatformProject';
import { getProjectPagination } from '../../data/project/projectPagination';
import { projects } from '../../data/projects';
import { getImage } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import type { OptimizedProjectImages } from '../../utils/projectImageAssets';

export function getStaticPaths() {
  return projects.filter((project) => project.showInGallery !== false).map((project) => ({
    params: { slug: project.slug },
    props: { project },
  }));
}

const { project } = Astro.props;

const detailComponents = {
  'smart-fitness': SmartFitnessDetail,
  'mobile-bank-2': MobileBankDetail,
  'hiring-2026': HiringDetail,
  'vip-platform': LifePlatformDetail,
  'iot-backend': IotGatewayDetail,
  'insurance-marketing': MarketingCollectionDetail,
};

const DetailComponent =
  detailComponents[project.slug as keyof typeof detailComponents];

const standardDetails = {
  'vip-member-platform': {
    cover: vipMemberPlatformCover,
    hero: vipMemberPlatformHero,
    goals: vipMemberPlatformGoals,
    sections: vipMemberPlatformContentSections,
    pagination: getProjectPagination('vip-member-platform'),
    goalsAfterFirstSection: true,
  },
  'hr-official': {
    cover: hrOfficialCover,
    hero: hrOfficialHero,
    goals: hrOfficialGoals,
    sections: hrOfficialContentSections,
    pagination: getProjectPagination('hr-official'),
    goalsAfterFirstSection: true,
  },
  'open-account': {
    cover: openAccountCover,
    hero: openAccountHero,
    goals: openAccountGoals,
    sections: openAccountContentSections,
    pagination: getProjectPagination('open-account'),
    goalsAfterFirstSection: true,
  },
  'job-platform': {
    cover: jobPlatformCover,
    hero: jobPlatformHero,
    goals: jobPlatformGoals,
    sections: jobPlatformContentSections,
    pagination: getProjectPagination('job-platform'),
    goalsAfterFirstSection: true,
  },
};

const standardDetail =
  standardDetails[project.slug as keyof typeof standardDetails];

const optimizedProjectFolders = {
  'mobile-bank-2': 'mobile-bank-detail',
  'smart-fitness': 'smart-fitness-detail',
} as const;
const optimizedProjectFolder =
  optimizedProjectFolders[project.slug as keyof typeof optimizedProjectFolders];
const projectImageLoaders = import.meta.glob<{ default: ImageMetadata }>(
  '../../assets/project-details/**/*.webp',
);
const optimizedProjectImages: OptimizedProjectImages = {};

if (optimizedProjectFolder) {
  const matchingImages = Object.entries(projectImageLoaders).filter(([path]) =>
    path.includes(`/project-details/${optimizedProjectFolder}/`),
  );

  await Promise.all(matchingImages.map(async ([path, loadImage]) => {
    const source = (await loadImage()).default;
    const filename = path.split('/').at(-1)!;
    const isMobileCover = filename === 'project-cover_m.webp';
    const isDesktopCover = filename === 'project-cover.webp';
    const widths = isMobileCover
      ? [480, 768, 960]
      : isDesktopCover
        ? [768, 1280, 1920]
        : [480, 768, 960, 1280];
    const fallbackWidth = widths.at(-1)!;
    const [avif, webp] = await Promise.all([
      getImage({ src: source, width: fallbackWidth, widths, format: 'avif', quality: 55 }),
      getImage({ src: source, width: fallbackWidth, widths, format: 'webp', quality: 82 }),
    ]);
    const mobileSrcset = (result: typeof avif) => result.srcSet.values
      .filter((value) => (value.transform.width ?? 0) <= 960)
      .map((value) => `${value.url} ${value.descriptor}`)
      .join(', ');
    const originalPath = `/Image/Project/${optimizedProjectFolder}/${filename}`;

    optimizedProjectImages[originalPath] = {
      src: webp.src,
      avifSrcset: avif.srcSet.attribute,
      webpSrcset: webp.srcSet.attribute,
      mobileAvifSrcset: mobileSrcset(avif),
      mobileWebpSrcset: mobileSrcset(webp),
      width: source.width,
      height: source.height,
    };
  }));
}
---

<BaseLayout
  title={`Timmy Lee｜${project.title}`}
  description={project.description}
>
  {DetailComponent && optimizedProjectFolder && (
    <DetailComponent optimizedImages={optimizedProjectImages} />
  )}
  {DetailComponent && !optimizedProjectFolder && <DetailComponent />}
  {standardDetail && <StandardProjectDetail {...standardDetail} />}
  <ProjectScrollEffects client:idle />
</BaseLayout>
