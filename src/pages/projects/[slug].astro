---
import BaseLayout from '../../layouts/BaseLayout.astro';
import HiringDetail from '../../components/project/HiringDetail.vue';
import MarketingCollectionDetail from '../../components/project/MarketingCollectionDetail.vue';
import MobileBankDetail from '../../components/project/MobileBankDetail.vue';
import ProjectScrollEffects from '../../components/project/ProjectScrollEffects.vue';
import StandardProjectDetail from '../../components/project/StandardProjectDetail.vue';
import {
  smartFitnessContentSections,
  smartFitnessCover,
  smartFitnessGoalsSection,
  smartFitnessHero,
} from '../../data/project/smartFitnessProject';
import {
  iotGatewayContentSections,
  iotGatewayCover,
  iotGatewayGoals,
  iotGatewayHero,
} from '../../data/project/iotGatewayProject';
import {
  lifePlatformContentSections,
  lifePlatformCover,
  lifePlatformGoals,
  lifePlatformHero,
} from '../../data/project/lifePlatformProject';
import {
  vipMemberPlatformContentSections,
  vipMemberPlatformCover,
  vipMemberPlatformGoals,
  vipMemberPlatformHero,
} from '../../data/project/vipMemberPlatformProject';
import {
  hrOfficialContentSections,
  hrOfficialCover,
  hrOfficialGoals,
  hrOfficialHero,
} from '../../data/project/hrOfficialProject';
import {
  openAccountContentSections,
  openAccountCover,
  openAccountGoals,
  openAccountHero,
} from '../../data/project/openAccountProject';
import {
  jobPlatformContentSections,
  jobPlatformCover,
  jobPlatformGoals,
  jobPlatformHero,
} from '../../data/project/jobPlatformProject';
import { getProjectPagination } from '../../data/project/projectPagination';
import { projects } from '../../data/projects';
import {
  loadOptimizedProjectImages,
  optimizedProjectFolders,
  type OptimizedProjectSlug,
} from '../../utils/optimizedProjectImages';

export function getStaticPaths() {
  return projects.filter((project) => project.showInGallery !== false).map((project) => ({
    params: { slug: project.slug },
    props: { project },
  }));
}

const { project } = Astro.props;

const detailComponents = {
  'mobile-bank-2': MobileBankDetail,
  'hiring-2026': HiringDetail,
  'insurance-marketing': MarketingCollectionDetail,
};

const DetailComponent =
  detailComponents[project.slug as keyof typeof detailComponents];

const standardDetails = {
  'smart-fitness': {
    cover: smartFitnessCover,
    hero: smartFitnessHero,
    goals: smartFitnessGoalsSection,
    sections: smartFitnessContentSections,
    pagination: getProjectPagination('smart-fitness'),
    goalsAfterFirstSection: true,
  },
  'vip-member-platform': {
    cover: vipMemberPlatformCover,
    hero: vipMemberPlatformHero,
    goals: vipMemberPlatformGoals,
    sections: vipMemberPlatformContentSections,
    pagination: getProjectPagination('vip-member-platform'),
    goalsAfterFirstSection: true,
  },
  'hr-official': {
    cover: hrOfficialCover,
    hero: hrOfficialHero,
    goals: hrOfficialGoals,
    sections: hrOfficialContentSections,
    pagination: getProjectPagination('hr-official'),
    goalsAfterFirstSection: true,
  },
  'open-account': {
    cover: openAccountCover,
    hero: openAccountHero,
    goals: openAccountGoals,
    sections: openAccountContentSections,
    pagination: getProjectPagination('open-account'),
    goalsAfterFirstSection: true,
  },
  'job-platform': {
    cover: jobPlatformCover,
    hero: jobPlatformHero,
    goals: jobPlatformGoals,
    sections: jobPlatformContentSections,
    pagination: getProjectPagination('job-platform'),
    goalsAfterFirstSection: true,
  },
  'vip-platform': {
    cover: lifePlatformCover,
    hero: lifePlatformHero,
    goals: lifePlatformGoals,
    sections: lifePlatformContentSections,
    pagination: getProjectPagination('vip-platform'),
    goalsAfterFirstSection: true,
  },
  'iot-backend': {
    cover: iotGatewayCover,
    hero: iotGatewayHero,
    goals: iotGatewayGoals,
    sections: iotGatewayContentSections,
    pagination: getProjectPagination('iot-backend'),
    goalsAfterFirstSection: true,
  },
};

const standardDetail =
  standardDetails[project.slug as keyof typeof standardDetails];

const optimizedProjectFolder =
  optimizedProjectFolders[project.slug as OptimizedProjectSlug];
const optimizedProjectImages = await loadOptimizedProjectImages(
  optimizedProjectFolder,
);
---

<BaseLayout
  title={`Timmy Lee｜${project.title}`}
  description={project.description}
>
  {DetailComponent && optimizedProjectFolder && (
    <DetailComponent optimizedImages={optimizedProjectImages} />
  )}
  {DetailComponent && !optimizedProjectFolder && <DetailComponent />}
  {standardDetail && (
    <StandardProjectDetail
      {...standardDetail}
      optimizedImages={optimizedProjectImages}
    />
  )}
  <ProjectScrollEffects client:idle />
</BaseLayout>
