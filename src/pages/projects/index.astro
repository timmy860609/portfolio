---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ProjectPageHero from '../../components/project/ProjectPageHero.vue';
import ProjectsGallery from '../../components/project/ProjectsGallery.vue';
import { withBase } from '../../utils/basePath';
---

<BaseLayout
  title="Timmy Lee｜精選案例"
  description="Timmy Lee 的 UI/UX、數位金融、IoT、品牌形象與會員服務設計案例。"
>
  <Fragment slot="head">
    <link
      rel="preload"
      as="image"
      type="image/avif"
      href={withBase('/Image/Optimized/project-covers/smart-fitness-960.avif')}
      fetchpriority="high"
    />
    <link
      rel="preload"
      as="image"
      type="image/avif"
      href={withBase('/Image/Optimized/project-covers/mobile-bank-960.avif')}
      fetchpriority="high"
    />
  </Fragment>
  <ProjectPageHero />
  <ProjectsGallery client:visible />
</BaseLayout>
