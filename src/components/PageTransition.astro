<div
  class="page-transition"
  aria-hidden="true"
  data-page-transition
  hidden
  transition:persist="page-transition-curtain-v2"
>
  <div class="page-transition__panel" data-page-transition-panel></div>
  <p class="page-transition__label" data-page-transition-label></p>
</div>

<script>
  const basePath = import.meta.env.BASE_URL.replace(/\/$/, '');
  const motionDuration = 560;
  let navigationSequence = 0;
  let phase: 'idle' | 'covering' | 'covered' | 'leaving' = 'idle';
  const transitionWindow = window as Window & {
    __pageTransitionController?: AbortController;
  };
  transitionWindow.__pageTransitionController?.abort();
  const eventController = new AbortController();
  transitionWindow.__pageTransitionController = eventController;

  const wait = (duration: number) =>
    new Promise<void>((resolve) => window.setTimeout(resolve, duration));

  const getDestination = (pathname: string) => {
    if (basePath && pathname.startsWith(basePath)) {
      pathname = pathname.slice(basePath.length) || '/';
    }

    if (pathname === '/') return 'Home';
    if (pathname.startsWith('/projects')) return 'Case Study';
    if (pathname.startsWith('/articles')) return 'Articles';
    if (pathname.startsWith('/about')) return 'About Me';
    return 'Timmy Lee';
  };

  const cancelAnimations = (transition: HTMLElement) => {
    transition.getAnimations().forEach((animation) => animation.cancel());
    transition
      .querySelectorAll<HTMLElement>('*')
      .forEach((element) =>
        element.getAnimations().forEach((animation) => animation.cancel()),
      );
  };

  const preloadCriticalImage = async (
    nextDocument: Document,
    signal: AbortSignal,
  ) => {
    const image = nextDocument.querySelector<HTMLImageElement>(
      'main img[fetchpriority="high"], main img[loading="eager"]',
    );
    if (!image || signal.aborted) return;

    const picture = image.closest('picture');
    const source = Array.from(
      picture?.querySelectorAll<HTMLSourceElement>('source') ?? [],
    ).find((candidate) => {
      const media = candidate.getAttribute('media');
      return !media || window.matchMedia(media).matches;
    });
    const preload = new Image();

    preload.decoding = 'async';
    preload.fetchPriority = 'high';
    preload.srcset = source?.srcset || image.srcset;
    preload.sizes = source?.sizes || image.sizes;
    preload.src = image.src;

    await Promise.race([
      preload.decode().catch(() => undefined),
      wait(window.matchMedia('(max-width: 767px)').matches ? 1200 : 800),
    ]);
  };

  document.addEventListener('astro:before-preparation', (event) => {
    const sequence = ++navigationSequence;
    const transition = document.querySelector<HTMLElement>('[data-page-transition]');
    const panel = transition?.querySelector<HTMLElement>('[data-page-transition-panel]');
    const label = transition?.querySelector<HTMLElement>('[data-page-transition-label]');
    const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    const shouldAnimate = Boolean(transition && panel && label && !reduceMotion);

    let coverPage: Promise<void> = Promise.resolve();

    if (transition && panel && label && shouldAnimate) {
      const source = event.sourceElement as HTMLElement | undefined;
      label.textContent =
        source?.dataset.transitionLabel || getDestination(event.to.pathname);

      cancelAnimations(transition);
      phase = 'covering';
      transition.hidden = false;
      transition.style.opacity = '1';
      panel.style.transform = 'translate3d(0, 101%, 0)';
      label.style.opacity = '0';

      const panelAnimation = panel.animate(
        [
          { transform: 'translate3d(0, 101%, 0)' },
          { transform: 'translate3d(0, 0, 0)' },
        ],
        {
          duration: motionDuration,
          easing: 'cubic-bezier(0.65, 0, 0.2, 1)',
          fill: 'forwards',
        },
      );
      const labelAnimation = label.animate(
        [
          { opacity: 0 },
          { opacity: 1 },
        ],
        {
          duration: 300,
          delay: 260,
          easing: 'ease-in-out',
          fill: 'forwards',
        },
      );

      coverPage = Promise.race([
        panelAnimation.finished.catch(() => undefined),
        wait(motionDuration + 80),
      ]).then(() => {
        if (
          eventController.signal.aborted ||
          sequence !== navigationSequence
        ) return;
        panel.style.transform = 'translate3d(0, 0, 0)';
        label.style.opacity = '1';
        phase = 'covered';
        panelAnimation.cancel();
        labelAnimation.cancel();
      });
    }

    const loadPage = event.loader;
    event.loader = async () => {
      const pageAndImage = loadPage().then(() =>
        preloadCriticalImage(event.newDocument, event.signal),
      );
      try {
        await Promise.all([coverPage, pageAndImage]);
        if (shouldAnimate && !event.signal.aborted) await wait(100);
      } catch (error) {
        if (sequence === navigationSequence && !eventController.signal.aborted && transition) {
          transition.hidden = true;
          cancelAnimations(transition);
          phase = 'idle';
        }
        throw error;
      }
    };
  }, { signal: eventController.signal });

  document.addEventListener('astro:after-swap', () => {
    const sequence = navigationSequence;
    const transition = document.querySelector<HTMLElement>('[data-page-transition]');
    const panel = transition?.querySelector<HTMLElement>('[data-page-transition-panel]');
    const label = transition?.querySelector<HTMLElement>('[data-page-transition-label]');
    if (!transition || !panel || !label || transition.hidden || phase !== 'covered') return;
    phase = 'leaving';

    cancelAnimations(transition);
    transition.style.opacity = '1';
    panel.style.transform = 'translate3d(0, 0, 0)';

    const fadeAnimation = transition.animate(
      [
        { opacity: 1 },
        { opacity: 0 },
      ],
      {
        duration: 420,
        easing: 'cubic-bezier(0.4, 0, 0.2, 1)',
        fill: 'forwards',
      },
    );
    label.animate(
      [
        { opacity: 1 },
        { opacity: 0 },
      ],
      {
        duration: 240,
        easing: 'ease-in',
        fill: 'forwards',
      },
    );

    Promise.race([
      fadeAnimation.finished.catch(() => undefined),
      wait(520),
    ]).then(() => {
      if (
        eventController.signal.aborted ||
        sequence !== navigationSequence
      ) return;
      transition.style.opacity = '0';
      transition.hidden = true;
      cancelAnimations(transition);
      transition.style.opacity = '1';
      panel.style.transform = 'translate3d(0, 101%, 0)';
      label.style.opacity = '';
      phase = 'idle';
    });
  }, { signal: eventController.signal });
</script>

<!-- Persistent DOM must retain its styles across client-side deployments.
     Global pseudo-element rules also disable the native root crossfade. -->
<style is:global>
  .page-transition {
    align-items: center;
    contain: paint;
    display: flex;
    inset: 0;
    justify-content: center;
    pointer-events: none;
    position: fixed;
    isolation: isolate;
    will-change: opacity;
    z-index: 10000;
  }

  .page-transition[hidden] {
    display: none;
  }

  .page-transition__panel {
    background: #00d9ff;
    inset: 0;
    position: absolute;
    transform: translate3d(0, 101%, 0);
    will-change: transform;
  }

  .page-transition__label {
    color: #202020;
    font-family: 'Montserrat', 'Noto Sans TC', sans-serif;
    font-size: clamp(48px, 9vw, 128px);
    font-weight: var(--font-weight-bold);
    letter-spacing: -0.03em;
    line-height: 1;
    margin: 0;
    max-width: calc(100% - 40px);
    position: relative;
    text-align: center;
    will-change: opacity;
    z-index: 1;
  }

  ::view-transition-old(root),
  ::view-transition-new(root) {
    animation: none;
    mix-blend-mode: normal;
  }

  ::view-transition-old(root) {
    display: none;
  }

  ::view-transition-group(root) {
    animation: none;
  }

  @media (prefers-reduced-motion: reduce) {
    .page-transition {
      display: none;
    }
  }
</style>
