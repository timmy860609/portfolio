<script>
  let dispose: (() => void) | undefined;

  function initializeVideos() {
    dispose?.();
    const controller = new AbortController();
    const { signal } = controller;
    const videos = Array.from(document.querySelectorAll<HTMLVideoElement>('video[data-managed-video]'));
    const visible = new Set<HTMLVideoElement>();
    const saveData = (navigator as Navigator & { connection?: { saveData?: boolean } }).connection?.saveData;

    function load(video: HTMLVideoElement, preload: 'auto' | 'metadata') {
      video.preload = preload;
      if (video.getAttribute('src')) return;
      const mobile = saveData || matchMedia('(max-width: 767px)').matches;
      const source = (mobile && video.dataset.mobileSrc) || video.dataset.src;
      if (!source) return;
      video.src = source;
      video.load();
    }

    async function play(video: HTMLVideoElement) {
      load(video, 'auto');
      const autoplay = video.hasAttribute('data-autoplay-on-view');
      if (autoplay) video.controls = false;
      try {
        await video.play();
      } catch (error) {
        // A pause during a pending play is expected when scrolling away.
        if (
          !autoplay &&
          !signal.aborted &&
          error instanceof DOMException &&
          error.name === 'NotAllowedError'
        ) {
          video.controls = true;
        }
      }
    }

    const preloadObserver = 'IntersectionObserver' in window ? new IntersectionObserver(entries => {
      entries.forEach(entry => {
        if (!entry.isIntersecting) return;
        const video = entry.target as HTMLVideoElement;
        load(video, video.hasAttribute('data-autoplay-on-view') ? 'auto' : 'metadata');
        preloadObserver?.unobserve(video);
      });
    }, { rootMargin: '1200px 0px' }) : undefined;

    const playbackObserver = 'IntersectionObserver' in window ? new IntersectionObserver(entries => {
      entries.forEach(entry => {
        const video = entry.target as HTMLVideoElement;
        if (entry.isIntersecting && entry.intersectionRatio >= 0.15) {
          visible.add(video);
          if (!document.hidden) void play(video);
        } else {
          visible.delete(video);
          video.pause();
          // Retain the buffered position instead of seeking back on every scroll.
        }
      });
    }, { threshold: [0, 0.15] }) : undefined;

    videos.forEach(video => {
      const autoplay = video.hasAttribute('data-autoplay-on-view');
      const button = video.closest('figure')?.querySelector<HTMLButtonElement>('[data-play-video]');
      button?.addEventListener('click', () => { void play(video); }, { signal });
      video.addEventListener('playing', () => { if (button) button.hidden = true; }, { signal });
      video.addEventListener('error', () => {
        if (!autoplay) video.controls = true;
      }, { signal });
      if (autoplay) {
        video.muted = true;
        video.defaultMuted = true;
        video.loop = true;
        video.playsInline = true;
        video.controls = false;
        video.addEventListener('canplay', () => {
          if (visible.has(video) && !document.hidden && video.paused) void play(video);
        }, { signal });
        if (playbackObserver) playbackObserver.observe(video);
        else {
          visible.add(video);
          void play(video);
        }
      }
      if (preloadObserver) preloadObserver.observe(video);
      else if (!autoplay) {
        load(video, 'metadata');
        video.controls = true;
      }
    });
    document.addEventListener('visibilitychange', () => {
      if (document.hidden) videos.forEach(video => video.pause());
      else visible.forEach(video => { void play(video); });
    }, { signal });
    dispose = () => {
      controller.abort();
      preloadObserver?.disconnect();
      playbackObserver?.disconnect();
      videos.forEach(video => video.pause());
    };
  }
  document.addEventListener('astro:page-load', initializeVideos);
  document.addEventListener('astro:before-swap', () => dispose?.());
</script>
