<script>
  let observer: IntersectionObserver | undefined;
  let controller: AbortController | undefined;

  function initializeImages() {
    observer?.disconnect();
    controller?.abort();
    controller = new AbortController();
    const { signal } = controller;
    const images = document.querySelectorAll<HTMLImageElement>('img[data-responsive-image]');
    if ('IntersectionObserver' in window) {
      const preloadDistance = window.matchMedia('(max-width: 767px)').matches
        ? 3000
        : 2000;
      observer = new IntersectionObserver(entries => {
        for (const entry of entries) {
          if (!entry.isIntersecting) continue;
          // Keep real src/srcset and native lazy loading as a no-JS fallback.
          const image = entry.target as HTMLImageElement;
          const distanceFromViewport = Math.max(
            0,
            entry.boundingClientRect.top - window.innerHeight,
          );
          image.fetchPriority = distanceFromViewport < window.innerHeight
            ? 'high'
            : 'low';
          image.loading = 'eager';
          observer?.unobserve(entry.target);
        }
      }, { rootMargin: `${preloadDistance}px 0px`, threshold: 0 });
    }
    images.forEach(image => {
      const reveal = async () => {
        if (!image.naturalWidth) return;
        await image.decode().catch(() => undefined);
        if (!signal.aborted) image.style.backgroundImage = 'none';
      };
      if (image.complete) void reveal();
      else image.addEventListener('load', reveal, { once: true, signal });
      if (image.loading === 'lazy') observer?.observe(image);
    });
  }
  document.addEventListener('astro:page-load', initializeImages);
  document.addEventListener('astro:before-swap', () => {
    observer?.disconnect();
    controller?.abort();
  });
</script>
