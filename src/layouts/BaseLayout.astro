---
import AppHeader from '../components/AppHeader.vue';
import PageTransition from '../components/PageTransition.astro';
import SiteFooter from '../components/SiteFooter.vue';
import { stripBase, withBase } from '../utils/basePath';
import { ClientRouter } from 'astro:transitions';
import '../styles/global.css';

interface Props {
  title: string;
  description: string;
}

const { title, description } = Astro.props;
const currentPath = stripBase(Astro.url.pathname).replace(/\/$/, '') || '/';
const accessPath = withBase('/access');
const faviconPath = withBase('/WebCI/ci-logo.svg');
---

<!doctype html>
<html lang="zh-Hant">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={description} />
    <meta name="generator" content={Astro.generator} />
    <link rel="icon" href={faviconPath} type="image/svg+xml" />
    <title>{title}</title>
    <script is:inline define:vars={{ accessPath }}>
      (() => {
        let hasAccess = false;
        try {
          hasAccess = sessionStorage.getItem('portfolio-access-granted') === 'true';
        } catch {
          hasAccess = false;
        }

        document.documentElement.classList.add(
          hasAccess ? 'portfolio-unlocked' : 'portfolio-locked',
        );

        if (!hasAccess) {
          const returnTo = `${window.location.pathname}${window.location.search}${window.location.hash}`;
          window.location.replace(
            `${accessPath}?returnTo=${encodeURIComponent(returnTo)}`,
          );
        }
      })();
    </script>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Noto+Sans+TC:wght@400;500;700&display=swap"
      media="print"
      onload="this.setAttribute('media', 'all')"
    />
    <noscript>
      <link
        rel="stylesheet"
        href="https://fonts.googleapis.com/css2?family=Noto+Sans+TC:wght@400;500;700&display=swap"
      />
    </noscript>
    <ClientRouter fallback="swap" />
  </head>
  <body>
    <div class="portfolio-site" data-portfolio-site>
      <AppHeader currentPath={currentPath} client:load />
      <main>
        <slot />
      </main>
      <SiteFooter />
      <PageTransition />
    </div>
  </body>
</html>
