---
import AppHeader from '../components/AppHeader.vue';
import VideoLoading from '../components/VideoLoading.astro';
import ImageLoading from '../components/ImageLoading.astro';
import PageTransition from '../components/PageTransition.astro';
import SiteFooter from '../components/SiteFooter.vue';
import { stripBase, withBase } from '../utils/basePath';
import { ClientRouter } from 'astro:transitions';
import '../styles/global.css';

interface Props {
  title: string;
  description: string;
}

const { title, description } = Astro.props;
const currentPath = stripBase(Astro.url.pathname).replace(/\/$/, '') || '/';
const faviconPath = withBase('/WebCI/Favicon.svg');
const socialTitle = 'Timmy Lee｜Product Designer';
const socialDescription =
  '設計不像其他學科，需要垂直鑽研；而是要水平發展，接觸各種不同的領域';
---

<!doctype html>
<html lang="zh-Hant">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="zh_TW" />
    <meta property="og:site_name" content="Timmy Lee Portfolio" />
    <meta property="og:title" content={socialTitle} />
    <meta property="og:description" content={socialDescription} />
    <meta property="og:url" content={Astro.url.href} />
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={socialTitle} />
    <meta name="twitter:description" content={socialDescription} />
    <meta name="generator" content={Astro.generator} />
    <link rel="icon" href={faviconPath} type="image/svg+xml" />
    <slot name="head" />
    <title>{title}</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Noto+Sans+TC:wght@400;500;700&display=swap"
      media="print"
      onload="this.setAttribute('media', 'all')"
    />
    <noscript>
      <link
        rel="stylesheet"
        href="https://fonts.googleapis.com/css2?family=Noto+Sans+TC:wght@400;500;700&display=swap"
      />
    </noscript>
    <ClientRouter fallback="swap" />
  </head>
  <body>
    <div class="portfolio-site">
      <AppHeader currentPath={currentPath} client:load />
      <main>
        <slot />
      </main>
      <SiteFooter />
      <PageTransition />
      <ImageLoading />
      <VideoLoading />
    </div>
  </body>
</html>
