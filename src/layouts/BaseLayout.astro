---
import AppHeader from '../components/AppHeader.vue';
import Analytics from '../components/Analytics.astro';
import VideoLoading from '../components/VideoLoading.astro';
import ImageLoading from '../components/ImageLoading.astro';
import PageTransition from '../components/PageTransition.astro';
import SiteFooter from '../components/SiteFooter.vue';
import { stripBase, withBase } from '../utils/basePath';
import { ClientRouter } from 'astro:transitions';
import '../styles/global.css';

interface Props {
  title: string;
  description: string;
}

const { title, description } = Astro.props;
const currentPath = stripBase(Astro.url.pathname).replace(/\/$/, '') || '/';
const faviconPath = withBase('/WebCI/Favicon.svg');
const faviconPngPath = withBase('/WebCI/Favicon-48.png');
const appleTouchIconPath = withBase('/WebCI/apple-touch-icon.png');
const manifestPath = withBase('/site.webmanifest');
const siteUrl = new URL('/', Astro.site ?? Astro.url).href;
const canonicalUrl = new URL(Astro.url.pathname, Astro.site ?? Astro.url).href;
const socialTitle = title;
const socialImageAlt = 'Timmy Lee Portfolio — 青白色背景上的作品集品牌標誌';
const socialImages = [
  { path: '/Image/og-image/media-share_l.jpg', width: 2400, height: 1260 },
  { path: '/Image/og-image/media-share_mjpg.jpg', width: 2160, height: 2160 },
].map((image) => ({
  ...image,
  url: new URL(withBase(image.path), Astro.site ?? Astro.url).href,
}));
const socialDescription = description;
const structuredData = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'WebSite',
      '@id': `${siteUrl}#website`,
      url: siteUrl,
      name: 'Timmy Lee Portfolio',
      alternateName: 'Timmy Lee｜Product Designer',
      inLanguage: 'zh-Hant',
    },
    {
      '@type': 'Person',
      '@id': `${siteUrl}#person`,
      name: 'Timmy Lee',
      alternateName: '李柏廷',
      url: siteUrl,
      jobTitle: 'Product Designer',
    },
  ],
};
---

<!doctype html>
<html lang="zh-Hant">
  <head>
    <meta charset="UTF-8" />
    <Analytics />
    <meta name="viewport" content="width=device-width" />
    <meta
      name="format-detection"
      content="telephone=no, date=no, address=no, email=no"
    />
    <meta name="description" content={description} />
    <meta
      name="robots"
      content="index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1"
    />
    <link rel="canonical" href={canonicalUrl} />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="zh_TW" />
    <meta property="og:site_name" content="Timmy Lee Portfolio" />
    <meta property="og:title" content={socialTitle} />
    <meta property="og:description" content={socialDescription} />
    <meta property="og:url" content={canonicalUrl} />
    {socialImages.map((image) => (
      <>
        <meta property="og:image" content={image.url} />
        <meta property="og:image:type" content="image/jpeg" />
        <meta property="og:image:width" content={String(image.width)} />
        <meta property="og:image:height" content={String(image.height)} />
        <meta property="og:image:alt" content={socialImageAlt} />
      </>
    ))}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:image" content={socialImages[0].url} />
    <meta name="twitter:image:alt" content={socialImageAlt} />
    <meta name="twitter:title" content={socialTitle} />
    <meta name="twitter:description" content={socialDescription} />
    <meta name="generator" content={Astro.generator} />
    <link rel="icon" href={faviconPath} type="image/svg+xml" />
    <link rel="icon" href={faviconPngPath} type="image/png" sizes="48x48" />
    <link rel="apple-touch-icon" href={appleTouchIconPath} sizes="180x180" />
    <link rel="manifest" href={manifestPath} />
    <meta name="theme-color" content="#fcfcfc" />
    <script type="application/ld+json" set:html={JSON.stringify(structuredData)} />
    <slot name="head" />
    <title>{title}</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Noto+Sans+TC:wght@400;500;700&display=swap"
      media="print"
      onload="this.setAttribute('media', 'all')"
    />
    <noscript>
      <link
        rel="stylesheet"
        href="https://fonts.googleapis.com/css2?family=Noto+Sans+TC:wght@400;500;700&display=swap"
      />
    </noscript>
    <ClientRouter fallback="swap" />
  </head>
  <body>
    <div class="portfolio-site">
      <AppHeader currentPath={currentPath} client:load />
      <main>
        <slot />
      </main>
      <SiteFooter />
      <PageTransition />
      <ImageLoading />
      <VideoLoading />
    </div>
  </body>
</html>
